# Personal Riot API key notes — never commit, use .env instead.
riot.txt

# Unofficial MetaTFT data (scripts/fetch-metatft.js) — regenerate locally, don't commit.
data/sets/*/meta-tiers.generated.json

# Real recorded matches contain other players' Riot IDs (summoner name + tag
# line) captured from the lobby roster — never publish someone else's data
# without consent. Add your own locally for regression testing; only .gitkeep
# is tracked.
tests/goldens/*.jsonl
!tests/goldens/.gitkeep

# Working output at the repo root: rule-audit reports (results/rule-audit) and
# the Riot match cache (results/riot-meta-cache). Regenerable, never shipped.
/results/*
!/results/.gitkeep

